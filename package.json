{
  "name": "weft",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=25.9.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "demo": "tsx apps/api/src/demo.ts",
    "demo:tests": "vitest run --project @weft/tests --reporter verbose tests/scenarios",
    "demo:scenario": "tsx scripts/demo-scenario.ts",
    "build": "turbo run build",
    "test": "vitest run",
    "typecheck": "turbo run typecheck",
    "e2e": "playwright test",
    "e2e:rich": "playwright test -c playwright.rich.config.ts",
    "screenshots": "playwright test -c playwright.screens.config.ts",
    "screenshots:rich": "playwright test -c playwright.screens-rich.config.ts",
    "e2e:tour": "playwright test -c playwright.tour.config.ts",
    "lint:prose": "tsx scripts/check-prose.ts",
    "lint:brand": "tsx scripts/check-brand.ts",
    "brand:overlap": "tsx scripts/brand-overlap.ts",
    "db:migrate": "tsx packages/db/src/cli.ts migrate",
    "db:seed": "tsx packages/seed/src/cli.ts seed",
    "db:reset": "tsx packages/seed/src/cli.ts reset",
    "db:digest": "tsx packages/seed/src/cli.ts digest",
    "eval:live": "tsx evals/live/run.ts",
    "eval:suite": "tsx evals/suite/run.ts",
    "eval:ci": "tsx evals/suite/run.ts --split all --variant both --provider scripted --gate --out evals/results/ci",
    "phoenix:up": "tsx scripts/phoenix.ts up",
    "phoenix:down": "tsx scripts/phoenix.ts down",
    "phoenix:status": "tsx scripts/phoenix.ts status",
    "wave:ledger": "tsx scripts/wave-ledger.ts",
    "memory:bundle": "tsx scripts/memory-bundle.ts",
    "memory:restore": "tsx scripts/memory-restore.ts"
  },
  "devDependencies": {
    "@arizeai/phoenix-client": "7.16.1",
    "@arizeai/phoenix-otel": "2.2.0",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
