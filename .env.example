# Weft environment (SPEC 4). No secrets here. Real keys live outside the repo in the file named by WEFT_SECRETS_FILE.
WEFT_DATA_DIR=.data
WEFT_API_PORT=4070
WEFT_WEB_PORT=3070
WEFT_DEV_AUTH=1
# scripted | openai | claude | mlx | llama
WEFT_LLM=scripted
WEFT_MODEL=gpt-5.6-luna
# Path outside the repo, for example ~/Developer/projects/.weft.secrets.env (holds OPENAI_API_KEY). Passed only to the API.
WEFT_SECRETS_FILE=
WEFT_RUN_USD_CAP=0.10
WEFT_DAY_USD_CAP=2.00
WEFT_LIVE_USD_CAP=0.50
# Set to 1 only for the live suite and the smoke calls.
WEFT_LIVE_OPENAI=
# Unset: unattended cron runs use templates.
WEFT_BACKGROUND_LLM=
# 1 after merge 2.
WEFT_PIN_PREFIX=
WEFT_SANDBOX=off
WEFT_T_ADMISSION_MS=2000
WEFT_T_MODEL_MS=120000
# Else generated into .data/vault.key (mode 0600).
WEFT_VAULT_KEY=
WEFT_CLOCK_RATE=1
WEFT_PRICES_JSON=
# Wave 3 integrations (README "Integrations"). Unset: every vendor runs its simulator. Credentials go only in the
# WEFT_SECRETS_FILE file, never here.
# 1 lets a vendor's real adapter replace its simulator once every required secret is present.
WEFT_INTEGRATIONS_REAL=
# checkr (default) | hireright
WEFT_SCREENING=
# builtin (default) | docusign
WEFT_ESIGN=
# 1 lets the real DocuSign adapter send envelopes (demo environment unless DOCUSIGN_ENV=production).
WEFT_LIVE_DOCUSIGN=
DOCUSIGN_ENV=
# 1 lets the real Checkr adapter reach production when CHECKR_ENV=production (staging otherwise).
WEFT_LIVE_CHECKR=
CHECKR_ENV=
