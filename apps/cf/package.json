{
  "name": "@weft/cf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "if [ -d src ] || [ -d test ] || [ -d generated ]; then tsc --noEmit -p .; else echo '@weft/cf: no sources yet (track cf4-worker)'; fi",
    "test": "vitest run",
    "test:workerd": "test -f vitest.workerd.config.ts || { echo '@weft/cf test:workerd: not built yet (track cf4-worker)'; exit 1; } && vitest run --config vitest.workerd.config.ts"
  },
  "dependencies": {
    "@weft/agent": "workspace:*",
    "@weft/api": "workspace:*",
    "@weft/cf-extras": "workspace:*",
    "@weft/contracts": "workspace:*",
    "@weft/core": "workspace:*",
    "@weft/db": "workspace:*",
    "@weft/executor": "workspace:*",
    "@weft/grounding": "workspace:*",
    "@weft/integrations": "workspace:*",
    "@weft/mcp": "workspace:*",
    "@weft/payroll-tax": "workspace:*",
    "@weft/routines": "workspace:*",
    "@weft/seed": "workspace:*",
    "@weft/sim": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "miniflare": "5.20261019.1-beta",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "workerd": "1.20261019.1",
    "wrangler": "4.151.3"
  }
}
