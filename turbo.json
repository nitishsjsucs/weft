{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["WEFT_STATIC_EXPORT", "NEXT_PUBLIC_WEFT_HOSTED"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "out/**"]
    },
    "typecheck": { "dependsOn": [], "outputs": [] },
    "test": { "outputs": [] }
  }
}
